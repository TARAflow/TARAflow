{
  "compilerOptions": {
    "module": "commonjs",
    "outDir": "./dist-electron",
    "target": "ES2020",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "shared/models": ["src/shared/models"],
      "shared/models/*": ["src/shared/models/*"],
      "audit/models": ["src/features/audit/models"],
      "audit/models/*": ["src/features/audit/models/*"]
    }
  },
  "include": [
    "electron/**/*",
  ],
  "exclude": ["node_modules", "dist", "dist-electron"]
}