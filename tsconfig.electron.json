{
  "compilerOptions": {
    "inlineSources": true,
    "inlineSourceMap": true,
    "module": "commonjs",
    "outDir": "./dist-electron",
    "target": "ES2021",
    "lib": ["ES2021"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "shared/models": ["src/shared/models"],
      "shared/models/*": ["src/shared/models/*"],
      "audit/models": ["src/features/audit/models"],
      "audit/models/*": ["src/features/audit/models/*"]
    }
  },
  "include": [
    "electron/**/*",
  ],
    "exclude": [
    "electron/tests/**/*",
    "node_modules",
    "dist",
    "dist-electron"
  ]
}