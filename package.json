{
  "name": "taraflow",
  "version": "0.8.8-alpha",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "description": "TARAflow App – Threat Analysis and Risk Assessment app build",
  "author": "Juergen M. <1004272+messi1@users.noreply.github.com>",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:component": "vitest run --config vitest.component.config.ts",
    "clean:electron": "rimraf dist-electron",
    "typecheck:electron": "tsc -p tsconfig.electron.json",
    "build:electron-dev": "npm run clean:electron && npm run typecheck:electron && node scripts/build-electron.mjs",
    "dev:electron": "npm run build:electron-dev && concurrently \"vite\" \"wait-on http://localhost:5173 && electron . --inspect=5858\"",
    "build:electron": "npm run build && npm run build:electron-dev && electron-builder",
    "build:electron:clean": "rimraf dist dist-electron release && npm run build:electron",
    "inline:shapes": "node scripts/inline-shapes.cjs",
    "report:cli": "tsx --tsconfig tsconfig.cli.json taraflow-reporter/taraflow-report.ts",
    "build:cli": "esbuild taraflow-reporter/taraflow-report.ts --bundle --platform=node --format=esm --external:@resvg/resvg-js --external:pdfmake --alias:app=./src/app --alias:features=./src/features --alias:shared=./src/shared --alias:i18n=./src/i18n --outfile=dist-cli/taraflow-report.js && chmod +x dist-cli/taraflow-report.js && cp taraflow-reporter/packaging/runtime-package.json dist-cli/package.json && npm install --omit=dev --prefix dist-cli",
    "package:cli:deb": "npm run build:cli && nfpm package --config taraflow-reporter/packaging/nfpm.yaml --packager deb --target ./release/",
    "verify:fixtures": "tsx scripts/verify-fixtures.ts",
    "verify:cli": "tsx --tsconfig tsconfig.cli.json taraflow-verifier/taraflow-verify.ts",
    "build:cli:verify": "esbuild taraflow-verifier/taraflow-verify.ts --bundle --platform=node --format=esm --alias:app=./src/app --alias:features=./src/features --alias:shared=./src/shared --outfile=dist-cli/taraflow-verify.js && chmod +x dist-cli/taraflow-verify.js",
    "package:cli:verify:deb": "npm run build:cli:verify && nfpm package --config taraflow-verifier/packaging/nfpm.yaml --packager deb --target ./release/"
  },
  "build": {
    "appId": "com.taraflow.app",
    "productName": "Taraflow",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build-resources/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build-resources/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build-resources/icon.icns"
    },
    "dmg": {
      "title": "TARAflow ${version}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "build-resources/icon.png",
      "build-resources/icon.ico",
      "package.json",
      "LICENSE"
    ],
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "../../usr/share/doc/taraflow/copyright"
      }
    ]
  },
  "dependencies": {
    "@codemirror/language": "^6.12.1",
    "@codemirror/lint": "^6.9.2",
    "@codemirror/view": "^6.39.11",
    "@emotion/react": "11.11.4",
    "@emotion/styled": "11.11.5",
    "@fontsource/roboto": "5.0.13",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "5.16.6",
    "@mui/material": "5.16.0",
    "@mui/x-data-grid": "6.20.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/pdfmake": "^0.2.12",
    "@uiw/react-codemirror": "^4.25.4",
    "ajv": "8.17.1",
    "asciidoctor": "^3.0.4",
    "d3": "^7.9.0",
    "html-entities": "2.5.2",
    "i18next": "25.7.1",
    "i18next-browser-languagedetector": "8.2.0",
    "keytar": "^7.9.0",
    "lucide-react": "0.556.0",
    "monaco-editor": "^0.55.1",
    "monaco-editor-react": "^1.0.2",
    "pako": "2.1.0",
    "papaparse": "^5.5.3",
    "pdfmake": "^0.3.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "16.5.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "6.23.1",
    "react-spinners": "0.14.1",
    "remark-gfm": "^4.0.1",
    "semver": "^7.8.5",
    "simple-git": "^3.30.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.1.5",
    "@testing-library/react": "14.1.2",
    "@types/d3": "^7.4.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "4.2.1",
    "concurrently": "^9.2.1",
    "dependency-cruiser": "^18.0.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "esbuild": "^0.28.1",
    "i18next-parser": "^9.3.0",
    "jsdom": "^29.1.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.0",
    "typescript": "5.3.3",
    "vite": "5.0.10",
    "vitest": "1.2.2",
    "wait-on": "^8.0.5"
  }
}
