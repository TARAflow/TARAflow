    "@mui/material": "5.16.0",
    "@mui/x-data-grid": "6.20.0",
    "ajv": "8.17.1",
    "asciidoctor": "^3.0.4",
    "html-entities": "2.5.2",
    "i18next": "25.7.1",
    "i18next-browser-languagedetector": "8.2.0",
    "lucide-react": "0.556.0",
    "pako": "2.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "16.5.0",
    "react-markdown": "^10.1.0",
