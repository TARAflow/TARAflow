  "hazards": {
    "hazards": [
      {
        "id": "H-01",
        "externalRef": "HZ-01",
        "label": "Fire not detected",
        "description": "Smoke is present but the detector does not reach the alarm state (blinded or manipulated measurement, raised threshold, wrong calibration, compromised firmware, out-of-service detector not noticed).",
        "hazardType": "thermal",
        "combinationType": "ANY",
        "systemRelevance": "in_scope",
        "source": "manual"
      },
      {
        "id": "H-02",
        "externalRef": "HZ-02",
        "label": "Alarm not transmitted",
        "description": "The detector decides on alarm but the fire panel does not receive it (loop message suppressed or spoofed reset/silence, relay path manipulated, panel interface compromised).",
        "hazardType": "thermal",
        "combinationType": "ANY",
        "systemRelevance": "in_scope",
        "source": "manual"
      },
      {
        "id": "H-03",
        "externalRef": "HZ-03",
        "label": "Delayed alarm",
        "description": "The alarm is raised too late (verification delay or pre-alarm stage extended, alarm held back by the firmware).",
        "hazardType": "thermal",
        "combinationType": "ANY",
        "systemRelevance": "in_scope",
        "source": "manual"
      },
      {
        "id": "H-04",
        "externalRef": "HZ-04",
        "label": "False alarm",
        "description": "Alarm without fire (threshold lowered, calibration shifted, spoofed test command, manipulated firmware) — unwarranted evacuation, possible release of an automatic extinguishing system, loss of trust in alarms.",
        "hazardType": "other",
        "combinationType": "ANY",
        "systemRelevance": "in_scope",
        "source": "manual"
      },
      {
        "id": "H-05",
        "externalRef": "HZ-05",
        "label": "Wrong fire location reported",
        "description": "The alarm reaches the panel with a wrong zone/address (manipulated zone assignment, altered alarm message).",
        "hazardType": "thermal",
        "combinationType": "ANY",
        "systemRelevance": "in_scope",
        "source": "manual"
      }
    ],
